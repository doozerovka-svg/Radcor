  "admin.html": {
    "links": [
      "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">",
      "<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>",
      "<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Space+Grotesk:wght@500;700&display=swap\" rel=\"stylesheet\">",
      "<link rel=\"stylesheet\" href=\"style.css?v=36.0\">"
    ],
    "scripts": [
      {
        "full": "<script>\r         let fileHandle = null;\r         let productsData = [];\r         let editingIndex = -1;\r \r         const tableBody = document.getElementById('tableBody');\r         const statusIndicator = document.getElementById('statusIndicator');\r         const statusText = document.getElementById('statusText');\r \r         // Check if File System Access API is supported\r         if (!window.showOpenFilePicker) {\r             alert(\"Ваш браузер не поддерживает File System Access API. Пожалуйста, используйте Chrome, Edge или Opera на ПК.\");\r         }\r \r         document.getElementById('btnOpenFile').addEventListener('click', async () => {\r             try {\r                 [fileHandle] = await window.showOpenFilePicker({\r                     types: [{\r                         description: 'JSON Files',\r                         accept: {'application/json': ['.json']}\r                     }],\r                     multiple: false\r                 });\r \r                 const file = await fileHandle.getFile();\r                 const contents = await file.text();\r                 productsData = JSON.parse(contents);\r \r                 statusIndicator.classList.add('active');\r                 statusText.innerText = \"Открыт файл: \" + file.name;\r                 \r                 document.getElementById('btnSaveFile').style.display = 'block';\r                 document.getElementById('btnAdd').style.display = 'block';\r \r                 renderTable();\r             } catch (err) {\r                 console.error(err);\r             }\r         });\r \r         document.getElementById('btnSaveFile').addEventListener('click', async () => {\r             if (!fileHandle) return;\r             try {\r                 const writable = await fileHandle.createWritable();\r                 await writable.write(JSON.stringify(productsData, null, 2));\r                 await writable.close();\r                 alert(\"Успешно сохранено в файл!\");\r             } catch (err) {\r                 console.error(err);\r                 alert(\"Ошибка при сохранении: \" + err.message);\r             }\r         });\r \r         function renderTable() {\r             tableBody.innerHTML = '';\r             if (productsData.length === 0) {\r                 tableBody.innerHTML = '<tr><td colspan=\"6\" style=\"text-align:center;\" data-i18n=\"admin_text_td\">Нет товаров</td></tr>';\r                 return;\r             }\r \r             productsData.forEach((p, index) => {\r                 const tr = document.createElement('tr');\r                 const volString = Array.isArray(p.volumes) ? p.volumes.join(', ') : p.volumes;\r                 \r                 tr.innerHTML = `\r                     <td><img src=\"${p.photo_url || ''}\" class=\"prod-img-min\" onerror=\"this.src='data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0MCIgaGVpZ2h0PSI0MCI+PHJlY3Qgd2lkdGg9IjEwMCUiIGhlaWdodD0iMTAwJSIgZmlsbD0iI2YwZjBmMCIvPjwvc3ZnPg=='\"></td>\r                     <td style=\"font-family: var(--font-code); font-size:13px\">${p.sku}</td>\r                     <td style=\"font-weight:500\">${p.name}</td>\r                     <td>${p.category}</td>\r                     <td>${volString}</td>\r                     <td style=\"text-align:right\">\r                         <div class=\"actions\" style=\"justify-content:flex-end\">\r                             <button class=\"btn btn-outline\" style=\"padding:4px 8px; font-size:12px\" onclick=\"openModal(${index})\" data-i18n=\"admin_text_button_19\">Изменить</button>\r                             <button class=\"btn btn-outline\" style=\"padding:4px 8px; font-size:12px; color:var(--colour-mol-red); border-color:var(--colour-mol-red)\" onclick=\"deleteProduct(${index})\" data-i18n=\"admin_text_button_20\">Удалить</button>\r                         </div>\r                     </td>\r                 `;\r                 tableBody.appendChild(tr);\r             });\r         }\r \r         // ===================== MODAL LOGIC =====================\r         const modal = document.getElementById('editModal');\r         \r         document.getElementById('btnAdd').addEventListener('click', () => {\r             openModal(-1);\r         });\r \r         function openModal(index) {\r             editingIndex = index;\r             document.getElementById('specsContainer').innerHTML = '';\r             \r             if (index === -1) {\r                 document.getElementById('modalTitle').innerText = 'Добавление товара';\r                 document.getElementById('f_sku').value = `MOL-${Math.floor(1000 + Math.random()*9000)}`;\r                 document.getElementById('f_name').value = '';\r                 document.getElementById('f_category').value = 'motor-oils';\r                 document.getElementById('f_photo').value = '';\r                 document.getElementById('f_volumes').value = '1, 4, 60, 208';\r                 document.getElementById('f_desc').value = '';\r             } else {\r                 document.getElementById('modalTitle').innerText = 'Редактирование товара';\r                 const p = productsData[index];\r                 document.getElementById('f_sku').value = p.sku || '';\r                 document.getElementById('f_name').value = p.name || '';\r                 document.getElementById('f_category').value = p.category || 'motor-oils';\r                 document.getElementById('f_photo').value = p.photo_url || '';\r                 document.getElementById('f_volumes').value = Array.isArray(p.volumes) ? p.volumes.join(', ') : (p.volumes || '');\r                 document.getElementById('f_desc').value = p.description || '';\r                 \r                 if (Array.isArray(p.specs)) {\r                     p.specs.forEach(s => addSpecRow(s.label, s.value));\r                 }\r             }\r             modal.classList.add('active');\r         }\r \r         function closeModal() {\r             modal.classList.remove('active');\r         }\r \r         document.getElementById('btnAddSpec').addEventListener('click', () => {\r             addSpecRow('', '');\r         });\r \r         function addSpecRow(label, value) {\r             const div = document.createElement('div');\r             div.className = 'spec-row';\r             div.innerHTML = `\r                 <input type=\"text\" placeholder=\"Название (напр. Вязкость)\" data-i18n-placeholder=\"admin_spec_label_ph\" value=\"${label.replace(/\"/g, '&quot;')}\">\r                 <input type=\"text\" placeholder=\"Значение (напр. 5W-30)\" data-i18n-placeholder=\"admin_spec_val_ph\" value=\"${value.replace(/\"/g, '&quot;')}\">\r                 <button class=\"btn btn-outline\" style=\"padding:0 10px; border-color:var(--colour-mol-red); color:var(--colour-mol-red)\" onclick=\"this.parentElement.remove()\">X</button>\r             `;\r             document.getElementById('specsContainer').appendChild(div);\r         }\r \r         document.getElementById('btnSaveModal').addEventListener('click', () => {\r             const sku = document.getElementById('f_sku').value;\r             const name = document.getElementById('f_name').value;\r             const category = document.getElementById('f_category').value;\r             const photo_url = document.getElementById('f_photo').value;\r             const desc = document.getElementById('f_desc').value;\r             \r             const volsRaw = document.getElementById('f_volumes').value;\r             const volumes = volsRaw.split(',').map(s => s.trim()).filter(s => s !== '').map(s => isNaN(s) ? s : Number(s));\r \r             const specs = [];\r             document.querySelectorAll('#specsContainer .spec-row').forEach(row => {\r                 const inputs = row.querySelectorAll('input');\r                 if (inputs[0].value.trim() !== '') {\r                     specs.push({ label: inputs[0].value.trim(), value: inputs[1].value.trim() });\r                 }\r             });\r \r             const newProduct = {\r                 sku, name, category, photo_url, volumes, description: desc, specs\r             };\r \r             if (editingIndex === -1) {\r                 productsData.unshift(newProduct);\r             } else {\r                 // merge with existing to preserve hidden fields like prices if they exist\r                 productsData[editingIndex] = { ...productsData[editingIndex], ...newProduct };\r             }\r \r             closeModal();\r             renderTable();\r         });\r \r         function deleteProduct(index) {\r             if (confirm(\"Вы уверены, что хотите удалить этот товар?\")) {\r                 productsData.splice(index, 1);\r                 renderTable();\r             }\r         }\r     </script>",
